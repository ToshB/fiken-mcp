{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fiken-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public is required for Client ID Metadata Documents (SSRF protection).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Own deployment on the account's workers.dev subdomain, no custom domain.
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "cc433831b51e46fa971a71ca6f37fb80" }],
  "durable_objects": {
    "bindings": [{ "name": "FIKEN_USER_QUEUE", "class_name": "FikenUserQueue" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FikenUserQueue"] }],
  "observability": {
    "enabled": true,
    // Our own log lines only. Invocation logs would store request URLs, which carry upload tokens
    // and OAuth codes.
    "logs": { "enabled": true, "invocation_logs": false }
  }
  // Secrets: FIKEN_CLIENT_ID, FIKEN_CLIENT_SECRET (wrangler secret put).
}
